{
  "name": "sms-openpayments",
  "version": "0.1.0",
  "private": true,
  "description": "Pagos por SMS en Colombia con Interledger y Open Payments",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "check:testwallet": "tsx scripts/check-test-wallet.ts",
    "verify": "npm run typecheck && npm test",
    "setup:rafiki": "tsx scripts/setup-rafiki.ts",
    "smoke:rafiki": "tsx scripts/smoke-rafiki.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@interledger/open-payments": "^7.4.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
