# Copia a .env y ajusta. NUNCA subas .env ni claves reales.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SQLITE_PATH=./data/sms-openpayments.sqlite

# Protección de endpoints /admin/*
ADMIN_API_TOKEN=dev-admin-token

# Clave de 32 bytes en base64 para AES-256-GCM. Generar: openssl rand -base64 32
ENCRYPTION_KEY=

# Proveedor de pagos: fake (local, sin credenciales) | openpayments (real)
PAYMENT_PROVIDER=fake
PAYMENT_CURRENCY=COP
PAYMENT_ASSET_SCALE=0

# Open Payments (PAYMENT_PROVIDER=openpayments)
# Wallet address de la APLICACIÓN (cliente), no de un usuario final.
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=

# SMS: mock (local) | <proveedor real>
SMS_PROVIDER=mock
SMS_FROM=+570000000000
SMS_WEBHOOK_SECRET=dev-webhook-secret
