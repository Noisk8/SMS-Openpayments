# Copia a .env y ajusta. NUNCA subas .env ni claves reales.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection string (shared by local dev and the Railway deployment).
DATABASE_URL=postgresql://user:password@localhost:5432/sms_openpayments

# Protección de endpoints /admin/*
ADMIN_API_TOKEN=dev-admin-token

# Clave de 32 bytes en base64 para AES-256-GCM. Generar: openssl rand -base64 32
ENCRYPTION_KEY=

# Proveedor de pagos: fake (local, sin credenciales) | openpayments (real)
PAYMENT_PROVIDER=fake
PAYMENT_CURRENCY=COP
PAYMENT_ASSET_SCALE=0

# Open Payments (PAYMENT_PROVIDER=openpayments)
# Wallet address de la APLICACIÓN (cliente), no de un usuario final.
# Pruebas: cuenta de Interledger Test Wallet (dinero de juguete). Ver docs/test-wallet.md.
# PAYMENT_CURRENCY/PAYMENT_ASSET_SCALE deben coincidir con el activo de esas wallets;
# compruébalo con: npm run check:testwallet -- <wallet_emisor> <wallet_receptor>
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=

# SMS: mock (local, sin credenciales) | twilio (real)
SMS_PROVIDER=mock
SMS_FROM=+570000000000
SMS_WEBHOOK_SECRET=dev-webhook-secret

# Twilio (SMS_PROVIDER=twilio). TWILIO_WEBHOOK_URL debe ser la URL pública exacta
# configurada en Twilio para el webhook entrante: se usa para validar la firma.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# Modo opcional de cuentas administradas en Rafiki local, solo fondos ficticios.
# Conserva DATABASE_URL existente. npm run setup:rafiki genera los secretos locales.
RAFIKI_TEST_MODE=false
RAFIKI_ADMIN_URL=http://127.0.0.1:3101/graphql
RAFIKI_WALLET_ADDRESS_BASE=https://rafiki-backend:3000/accounts
RAFIKI_TENANT_ID=
RAFIKI_API_SECRET=
RAFIKI_WEBHOOK_SECRET=
RAFIKI_STREAM_SECRET=
RAFIKI_DB_ENCRYPTION_SECRET=
RAFIKI_DB_PASSWORD=
