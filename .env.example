# ==============================================================
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env ni secretos reales al repositorio.
# ==============================================================

# PostgreSQL (desarrollo local con docker compose: puerto 5432)
DATABASE_URL=postgresql://sms:sms_dev_password@localhost:5432/sms_interledger

APP_URL=http://localhost:3000
NODE_ENV=development

# Proveedores (cambiar sin modificar la lógica de pagos)
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock

# Moneda del modo mock. Escala de COP = 0 (sin decimales)
MOCK_CURRENCY=COP
MOCK_ASSET_SCALE=0

# Clave de 32 bytes en base64 para AES-256-GCM.
# Generar con: openssl rand -base64 32
ENCRYPTION_KEY=

# Simulador SMS (solo development/test; nunca en producción)
SMS_SIMULATOR_ENABLED=true

# Sesiones web
SESSION_TTL_SECONDS=3600

# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Onurix (SMS_PROVIDER=onurix): solo envío implementado; la recepción está pendiente. Ver docs/sms-providers.md
ONURIX_API_KEY=
ONURIX_CLIENT_ID=
ONURIX_WEBHOOK_SECRET=

# Inalambria (SMS_PROVIDER=inalambria): usuario y contraseña de la cuenta de envío.
# Solo envío implementado; la recepción está pendiente. Ver docs/sms-providers.md
INALAMBRIA_USER=
INALAMBRIA_PASSWORD=

# Proveedor genérico HTTP (SMS_PROVIDER=generic)
GENERIC_SMS_API_URL=
GENERIC_SMS_API_KEY=
GENERIC_SMS_WEBHOOK_SECRET=

# Open Payments (PAYMENT_PROVIDER=openpayments)
# Wallet address de la APLICACIÓN (cliente), no de un usuario final.
OPENPAYMENTS_CLIENT_WALLET_ADDRESS=
OPENPAYMENTS_KEY_ID=
OPENPAYMENTS_PRIVATE_KEY_PATH=
